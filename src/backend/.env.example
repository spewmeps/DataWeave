# 留空时默认写入项目 src/.data；生产环境建议配置为持久卷的绝对路径。
DATAWEAVE_DATA_DIR=
DATAWEAVE_PARSER=mineru
DATAWEAVE_LOG_LEVEL=INFO
DATAWEAVE_LOG_MAX_BYTES=10485760
DATAWEAVE_LOG_BACKUP_COUNT=5

# 可选：用于加密前端保存的 Provider Key。生产环境必须由 Secret Manager 注入 Fernet Key；
# 本地未配置时会在 src/.data/secrets 下生成权限为 0600 的开发密钥文件。
DATAWEAVE_CREDENTIAL_KEY=

# Demo 默认使用远程 API 的 Mock Transport。接入真实 MinerU 服务时改为 false。
MINERU_MOCK=true
MINERU_API_URL=https://mineru.net
MINERU_API_KEY=
MINERU_TIER=standard
MINERU_MODEL_VERSION=vlm
MINERU_POLL_INTERVAL_SECONDS=1.0
MINERU_TIMEOUT_SECONDS=600

# Schema 字段映射。测试时显式改成 mock；真实运行不会自动回退。
SCHEMA_EXTRACTOR_MODE=deepagents
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-flash
SCHEMA_EXTRACTION_MAX_SOURCE_CHARS=120000
SCHEMA_EXTRACTION_ENABLE_THINKING=true
SCHEMA_EXTRACTION_TIMEOUT_SECONDS=300
